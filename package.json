{
  "name": "simple-git-view",
  "displayName": "Simple Git View",
  "description": "A simple VSCode extension to view git repository status, history, and diffs.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "simpleGitView.showHistory",
        "title": "Git View: Show Commit History"
      },
      {
        "command": "simpleGitView.refreshStatus",
        "title": "Git View: Refresh Status",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simpleGitViewContainer",
          "title": "Simple Git View",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "simpleGitViewContainer": [
        {
          "id": "simpleGitView.gitStatus",
          "name": "Git Status"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "simpleGitView.refreshStatus",
          "when": "view == simpleGitView.gitStatus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.0.0"
  }
}
